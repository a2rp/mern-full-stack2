# Local emulator configuration. Copy this file to .env and replace both secrets.
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mern-full-stack2
TOKEN_KEY=replace-with-a-random-secret-at-least-32-bytes
ADMIN_REGISTRATION_KEY=replace-with-a-different-random-secret-at-least-32-bytes
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://gurukul-task.web.app
COOKIE_SAME_SITE=strict

# For production, set NODE_ENV=production, use a MongoDB Atlas URI, limit
# CLIENT_ORIGIN to the deployed frontend, and set COOKIE_SAME_SITE=none.
